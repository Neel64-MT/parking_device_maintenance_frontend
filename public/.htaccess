DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Node API (same host as this site; port matches vite.config.js)
  <IfModule mod_proxy.c>
    RewriteRule ^api(/.*)?$ http://127.0.0.1:5050/api$1 [P,L]
    RewriteRule ^uploads(/.*)?$ http://127.0.0.1:5050/uploads$1 [P,L]
  </IfModule>

  # React Router: serve index.html for client-side routes
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
